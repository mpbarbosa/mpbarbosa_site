{
  "name": "mpbarbosa-landing-page",
  "version": "1.0.0",
  "description": "A personal landing page for showcasing curriculum and projects of MP Barbosa.",
  "type": "module",
  "main": "src/index.html",
  "scripts": {
    "start": "live-server .",
    "build": "echo 'Build step not defined yet.'",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js 2>&1 | grep -v 'localstorage-file'",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage 2>&1 | grep -v 'localstorage-file'",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration",
    "test:shell": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects shell-scripts",
    "test:docs": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects documentation",
    "test:a11y": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects accessibility",
    "test:pa11y": "node scripts/test-accessibility.mjs",
    "test:parallel": "node --experimental-vm-modules node_modules/jest/bin/jest.js --maxWorkers=50%",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage --maxWorkers=2",
    "lint": "eslint . --ext .js,.mjs",
    "lint:fix": "eslint . --ext .js,.mjs --fix",
    "lint:report": "eslint . --ext .js,.mjs --format json --output-file eslint-report.json",
    "lint:md": "mdl --git-recurse --ignore-front-matter .",
    "format": "prettier --write \"**/*.{js,mjs,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,css,html,md}\"",
    "prepare": "husky"
  },
  "keywords": [
    "landing page",
    "personal website",
    "portfolio"
  ],
  "author": "MP Barbosa",
  "license": "MIT",
  "engines": {
    "node": ">=25.2.1",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "axe-core": "4.11.0",
    "axe-puppeteer": "1.1.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-jest": "28.14.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-junit": "^16.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "lint-staged": "15.5.2",
    "live-server": "^1.2.1",
    "pa11y": "9.0.1",
    "prettier": "3.7.4",
    "wait-on": "9.0.3"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "glob": "^11.0.0"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  }
}
