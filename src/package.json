{
  "name": "mpbarbosa-landing-page",
  "version": "1.0.0",
  "description": "A personal landing page for showcasing curriculum and projects of MP Barbosa.",
  "type": "module",
  "main": "src/index.html",
  "scripts": {
    "start": "live-server .",
    "build": "echo 'Build step not defined yet.'",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint:md": "mdl --git-recurse --ignore-front-matter ."
  },
  "keywords": [
    "landing page",
    "personal website",
    "portfolio"
  ],
  "author": "MP Barbosa",
  "license": "MIT",
  "devDependencies": {
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "live-server": "^1.2.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {},
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "collectCoverageFrom": [
      "scripts/**/*.{js,mjs}",
      "submodules/guia_turistico/src/libs/guia_js/src/**/*.js",
      "submodules/music_in_numbers/src/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/coverage/"
    ]
  }
}
