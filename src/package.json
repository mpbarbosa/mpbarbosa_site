{
  "name": "mpbarbosa-landing-page",
  "version": "1.0.0",
  "description": "A personal landing page for showcasing curriculum and projects of MP Barbosa.",
  "main": "src/index.html",
  "scripts": {
    "start": "live-server src",
    "build": "echo 'Build step not defined yet.'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "landing page",
    "personal website",
    "portfolio"
  ],
  "author": "MP Barbosa",
  "license": "MIT",
  "devDependencies": {
    "jest": "^30.2.0",
    "live-server": "^1.2.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "collectCoverageFrom": [
      "submodules/guia_turistico/src/libs/guia_js/src/**/*.js"
    ]
  }
}
