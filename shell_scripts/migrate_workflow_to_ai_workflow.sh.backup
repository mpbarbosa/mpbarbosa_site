#!/bin/bash
################################################################################
# Workflow Migration Script
# Purpose: Migrate workflow automation files to ai_workflow repository
# Version: 1.1.8
# Created: December 18, 2025
#
# Migrates:
# - docs/workflow-automation/* → ../ai_workflow/docs/workflow-automation/
# - shell_scripts/workflow/* → ../ai_workflow/shell_scripts/workflow/
#
# Preserves:
# - Complete folder structure
# - File permissions
# - Git history (via separate repository)
################################################################################

set -euo pipefail

# ==============================================================================
# CONFIGURATION
# ==============================================================================

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color

# Script version
SCRIPT_VERSION="1.1.8"

# Project directories
SOURCE_PROJECT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET_PROJECT="${SOURCE_PROJECT}/../ai_workflow"

# Source paths
SOURCE_DOCS="${SOURCE_PROJECT}/docs/workflow-automation"
SOURCE_SCRIPTS="${SOURCE_PROJECT}/shell_scripts/workflow"

# Target paths
TARGET_DOCS="${TARGET_PROJECT}/docs/workflow-automation"
TARGET_SCRIPTS="${TARGET_PROJECT}/shell_scripts/workflow"

# Migration metadata
MIGRATION_DATE="$(date '+%Y-%m-%d %H:%M:%S')"
MIGRATION_LOG="${SOURCE_PROJECT}/shell_scripts/workflow_migration_log_$(date +%Y%m%d_%H%M%S).txt"

# Debug and verbosity modes
DRY_RUN=false
DEBUG_MODE=false
VERBOSE_MODE=false
TRACE_MODE=false

# Debug log (separate from migration log)
DEBUG_LOG="${SOURCE_PROJECT}/shell_scripts/workflow_migration_debug_$(date +%Y%m%d_%H%M%S).log"

# Performance tracking
declare -A FUNCTION_START_TIMES
declare -A FUNCTION_CALL_COUNTS

# Call stack tracking
CALL_STACK=()
STACK_DEPTH=0

# ==============================================================================
# DEBUG AND LOGGING FUNCTIONS
# ==============================================================================

# Debug logging function
debug_log() {
    if [[ "${DEBUG_MODE}" == true || "${TRACE_MODE}" == true ]]; then
        local level="$1"
        shift
        local message="$*"
        local timestamp=$(date '+%Y-%m-%d %H:%M:%S.%3N')
        local caller="${FUNCNAME[1]}"
        
        echo "[${timestamp}] [${level}] [${caller}] ${message}" >> "${DEBUG_LOG}"
        
        # Also print to stderr if TRACE_MODE
        if [[ "${TRACE_MODE}" == true ]]; then
            echo -e "${GRAY}[DEBUG:${level}] ${message}${NC}" >&2
        fi
    fi
}

# Variable inspection
debug_var() {
    if [[ "${DEBUG_MODE}" == true || "${TRACE_MODE}" == true ]]; then
        local var_name="$1"
        local var_value="${!1}"
        debug_log "VAR" "${var_name}='${var_value}'"
        
        if [[ "${TRACE_MODE}" == true ]]; then
            echo -e "${GRAY}  → ${var_name}='${var_value}'${NC}" >&2
        fi
    fi
}

# Array inspection
debug_array() {
    if [[ "${DEBUG_MODE}" == true || "${TRACE_MODE}" == true ]]; then
        local array_name="$1"
        local -n array_ref="$1"
        
        debug_log "ARRAY" "${array_name} has ${#array_ref[@]} elements"
        
        local i=0
        for element in "${array_ref[@]}"; do
            debug_log "ARRAY" "  ${array_name}[$i]='${element}'"
            ((i++))
        done
        
        if [[ "${TRACE_MODE}" == true ]]; then
            echo -e "${GRAY}  → ${array_name}[${#array_ref[@]}]${NC}" >&2
        fi
    fi
}

# Function entry tracking
function_enter() {
    local func_name="${FUNCNAME[1]}"
    CALL_STACK+=("${func_name}")
    
    FUNCTION_START_TIMES["${func_name}-${STACK_DEPTH}"]=$(date +%s%3N)
    FUNCTION_CALL_COUNTS["${func_name}"]=$((${FUNCTION_CALL_COUNTS["${func_name}"]:-0} + 1))
    
    STACK_DEPTH=$((STACK_DEPTH + 1))
    
    debug_log "ENTER" "${func_name} (depth=${STACK_DEPTH}, call#=${FUNCTION_CALL_COUNTS["${func_name}"]})"
    
    if [[ "${VERBOSE_MODE}" == true ]]; then
        local indent=$(printf '%*s' $(((STACK_DEPTH - 1) * 2)) '')
        echo -e "${MAGENTA}${indent}→ ${func_name}${NC}" >&2
    fi
}

# Function exit tracking
function_exit() {
    local return_code="${1:-0}"
    
    STACK_DEPTH=$((STACK_DEPTH - 1))
    
    local func_name="${CALL_STACK[-1]}"
    local start_time="${FUNCTION_START_TIMES["${func_name}-${STACK_DEPTH}"]}"
    local end_time=$(date +%s%3N)
    local duration=$((end_time - start_time))
    
    debug_log "EXIT" "${func_name} returned ${return_code} (duration=${duration}ms)"
    
    if [[ "${VERBOSE_MODE}" == true ]]; then
        local indent=$(printf '%*s' $((STACK_DEPTH * 2)) '')
        echo -e "${MAGENTA}${indent}← ${func_name} [${duration}ms]${NC}" >&2
    fi
    
    unset 'CALL_STACK[-1]'
    unset "FUNCTION_START_TIMES[${func_name}-${STACK_DEPTH}]"
    
    return "${return_code}"
}

# Command execution with tracing
debug_exec() {
    local cmd="$*"
    
    debug_log "EXEC" "Running: ${cmd}"
    
    if [[ "${TRACE_MODE}" == true ]]; then
        echo -e "${CYAN}  ⚙ ${cmd}${NC}" >&2
    fi
    
    if [[ "${DRY_RUN}" == true ]]; then
        debug_log "EXEC" "SKIPPED (dry-run): ${cmd}"
        if [[ "${VERBOSE_MODE}" == true ]]; then
            echo -e "${YELLOW}  [DRY-RUN] Would execute: ${cmd}${NC}" >&2
        fi
        return 0
    fi
    
    # Capture both stdout and stderr
    local output
    local exit_code
    
    output=$(eval "${cmd}" 2>&1)
    exit_code=$?
    
    if [[ -n "${output}" ]]; then
        debug_log "OUTPUT" "${output}"
        
        if [[ "${TRACE_MODE}" == true ]]; then
            echo -e "${GRAY}${output}${NC}" >&2
        fi
    fi
    
    debug_log "EXEC" "Exit code: ${exit_code}"
    
    return "${exit_code}"
}

# Error context with stack trace
print_error_with_context() {
    local error_msg="$1"
    local line_num="${2:-${LINENO}}"
    
    print_error "${error_msg}"
    
    if [[ "${DEBUG_MODE}" == true || "${VERBOSE_MODE}" == true ]]; then
        echo -e "${RED}Error at line ${line_num}${NC}" >&2
        echo -e "${RED}Call stack:${NC}" >&2
        
        local i=0
        for func in "${CALL_STACK[@]}"; do
            echo -e "${RED}  $i: ${func}${NC}" >&2
            ((i++))
        done
    fi
    
    debug_log "ERROR" "${error_msg} at line ${line_num}"
    debug_array "CALL_STACK"
}

# Performance summary
print_performance_summary() {
    if [[ "${DEBUG_MODE}" == true || "${VERBOSE_MODE}" == true ]]; then
        echo ""
        echo -e "${CYAN}Performance Summary:${NC}"
        echo -e "${CYAN}══════════════════════════════════════${NC}"
        
        for func in "${!FUNCTION_CALL_COUNTS[@]}"; do
            local calls="${FUNCTION_CALL_COUNTS[$func]}"
            echo "  ${func}: ${calls} call(s)"
        done | sort
        
        echo ""
    fi
    
    debug_log "PERF" "Performance summary generated"
    for func in "${!FUNCTION_CALL_COUNTS[@]}"; do
        debug_log "PERF" "${func}: ${FUNCTION_CALL_COUNTS[$func]} calls"
    done
}

# ==============================================================================
# HELPER FUNCTIONS
# ==============================================================================

print_header() {
    function_enter
    
    echo ""
    echo -e "${CYAN}════════════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}  $1${NC}"
    echo -e "${CYAN}════════════════════════════════════════════════════════════════${NC}"
    echo ""
    
    debug_log "HEADER" "$1"
    function_exit 0
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
    debug_log "SUCCESS" "$1"
}

print_error() {
    echo -e "${RED}✗${NC} $1" >&2
    debug_log "ERROR" "$1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
    debug_log "WARNING" "$1"
}

print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
    debug_log "INFO" "$1"
}

log_action() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "${MIGRATION_LOG}"
    debug_log "ACTION" "$1"
}

# ==============================================================================
# VALIDATION FUNCTIONS
# ==============================================================================

validate_source_project() {
    function_enter
    
    print_info "Validating source project..."
    
    debug_var "SOURCE_PROJECT"
    debug_var "SOURCE_DOCS"
    debug_var "SOURCE_SCRIPTS"
    
    # Check source project directory
    if [[ ! -d "${SOURCE_PROJECT}" ]]; then
        print_error_with_context "Source project not found: ${SOURCE_PROJECT}" "${LINENO}"
        function_exit 1
        return 1
    fi
    debug_log "CHECK" "Source project exists: ${SOURCE_PROJECT}"
    
    # Check documentation directory
    if [[ ! -d "${SOURCE_DOCS}" ]]; then
        print_error_with_context "Source documentation not found: ${SOURCE_DOCS}" "${LINENO}"
        function_exit 1
        return 1
    fi
    local doc_count=$(find "${SOURCE_DOCS}" -type f 2>/dev/null | wc -l)
    debug_log "CHECK" "Documentation directory exists with ${doc_count} files"
    
    # Check scripts directory
    if [[ ! -d "${SOURCE_SCRIPTS}" ]]; then
        print_error_with_context "Source scripts not found: ${SOURCE_SCRIPTS}" "${LINENO}"
        function_exit 1
        return 1
    fi
    local script_count=$(find "${SOURCE_SCRIPTS}" -type f -name "*.sh" 2>/dev/null | wc -l)
    debug_log "CHECK" "Scripts directory exists with ${script_count} shell scripts"
    
    # Additional checks for key subdirectories
    if [[ -d "${SOURCE_SCRIPTS}/lib" ]]; then
        local lib_count=$(find "${SOURCE_SCRIPTS}/lib" -type f -name "*.sh" 2>/dev/null | wc -l)
        debug_log "CHECK" "Library modules found: ${lib_count} files"
    fi
    
    if [[ -d "${SOURCE_SCRIPTS}/steps" ]]; then
        local step_count=$(find "${SOURCE_SCRIPTS}/steps" -type f -name "*.sh" 2>/dev/null | wc -l)
        debug_log "CHECK" "Step modules found: ${step_count} files"
    fi
    
    print_success "Source project validated"
    log_action "Source project validated: ${SOURCE_PROJECT}"
    
    function_exit 0
    return 0
}

validate_target_project() {
    function_enter
    
    print_info "Validating target project..."
    
    debug_var "TARGET_PROJECT"
    debug_var "TARGET_DOCS"
    debug_var "TARGET_SCRIPTS"
    
    # Check if target exists
    if [[ ! -d "${TARGET_PROJECT}" ]]; then
        print_warning "Target project not found: ${TARGET_PROJECT}"
        print_info "Target project directory will be created"
        log_action "Target project will be created: ${TARGET_PROJECT}"
        debug_log "CHECK" "Target project does not exist, will be created"
        function_exit 0
        return 0
    fi
    
    debug_log "CHECK" "Target project exists: ${TARGET_PROJECT}"
    
    # Check if it's a git repository
    if [[ -d "${TARGET_PROJECT}/.git" ]]; then
        print_success "Target is a git repository"
        log_action "Target is git repository: ${TARGET_PROJECT}"
        debug_log "CHECK" "Target has .git directory"
        
        # Get current branch and commit info
        if command -v git &>/dev/null; then
            local current_branch=$(cd "${TARGET_PROJECT}" && git branch --show-current 2>/dev/null)
            local commit_count=$(cd "${TARGET_PROJECT}" && git rev-list --count HEAD 2>/dev/null)
            debug_log "GIT" "Target branch: ${current_branch:-none}"
            debug_log "GIT" "Target commits: ${commit_count:-0}"
            
            if [[ "${VERBOSE_MODE}" == true ]]; then
                echo -e "${GRAY}  Git branch: ${current_branch:-none}${NC}" >&2
                echo -e "${GRAY}  Commits: ${commit_count:-0}${NC}" >&2
            fi
        fi
    else
        print_warning "Target exists but is not a git repository"
        log_action "Target is not git repository: ${TARGET_PROJECT}"
        debug_log "CHECK" "Target exists but no .git directory"
        
        # Check what's already in target
        if [[ -d "${TARGET_DOCS}" ]]; then
            local existing_docs=$(find "${TARGET_DOCS}" -type f 2>/dev/null | wc -l)
            debug_log "CHECK" "Target docs exist with ${existing_docs} files"
            print_warning "Target docs directory already has ${existing_docs} files"
        fi
        
        if [[ -d "${TARGET_SCRIPTS}" ]]; then
            local existing_scripts=$(find "${TARGET_SCRIPTS}" -type f -name "*.sh" 2>/dev/null | wc -l)
            debug_log "CHECK" "Target scripts exist with ${existing_scripts} files"
            print_warning "Target scripts directory already has ${existing_scripts} shell scripts"
        fi
    fi
    
    function_exit 0
    return 0
}

# ==============================================================================
# MIGRATION ANALYSIS
# ==============================================================================

analyze_migration() {
    function_enter
    
    print_header "MIGRATION ANALYSIS"
    
    echo "Source Project: ${SOURCE_PROJECT}"
    echo "Target Project: ${TARGET_PROJECT}"
    echo ""
    
    debug_log "ANALYSIS" "Starting migration analysis"
    
    # Count documentation files
    local doc_count=0
    if [[ -d "${SOURCE_DOCS}" ]]; then
        doc_count=$(find "${SOURCE_DOCS}" -type f 2>/dev/null | wc -l)
        debug_log "COUNT" "Documentation files: ${doc_count}"
    else
        debug_log "WARNING" "Documentation directory not found"
    fi
    
    # Count script files
    local script_count=0
    if [[ -d "${SOURCE_SCRIPTS}" ]]; then
        script_count=$(find "${SOURCE_SCRIPTS}" -type f 2>/dev/null | wc -l)
        debug_log "COUNT" "Total script files: ${script_count}"
    else
        debug_log "WARNING" "Scripts directory not found"
    fi
    
    # Count by file type
    local sh_count=0
    local yaml_count=0
    local md_count=0
    
    if [[ -d "${SOURCE_SCRIPTS}" ]]; then
        sh_count=$(find "${SOURCE_SCRIPTS}" -type f -name "*.sh" 2>/dev/null | wc -l)
        yaml_count=$(find "${SOURCE_SCRIPTS}" -type f -name "*.yaml" -o -name "*.yml" 2>/dev/null | wc -l)
        debug_log "COUNT" "Shell scripts (.sh): ${sh_count}"
        debug_log "COUNT" "YAML files: ${yaml_count}"
    fi
    
    if [[ -d "${SOURCE_DOCS}" ]]; then
        md_count=$(find "${SOURCE_DOCS}" -type f -name "*.md" 2>/dev/null | wc -l)
        debug_log "COUNT" "Markdown files (.md): ${md_count}"
    fi
    
    # Calculate total size
    local docs_size=0
    local docs_size_bytes=0
    if [[ -d "${SOURCE_DOCS}" ]]; then
        docs_size=$(du -sh "${SOURCE_DOCS}" 2>/dev/null | cut -f1)
        docs_size_bytes=$(du -sb "${SOURCE_DOCS}" 2>/dev/null | cut -f1)
        debug_log "SIZE" "Documentation: ${docs_size} (${docs_size_bytes} bytes)"
    fi
    
    local scripts_size=0
    local scripts_size_bytes=0
    if [[ -d "${SOURCE_SCRIPTS}" ]]; then
        scripts_size=$(du -sh "${SOURCE_SCRIPTS}" 2>/dev/null | cut -f1)
        scripts_size_bytes=$(du -sb "${SOURCE_SCRIPTS}" 2>/dev/null | cut -f1)
        debug_log "SIZE" "Scripts: ${scripts_size} (${scripts_size_bytes} bytes)"
    fi
    
    echo "Documentation Files:"
    echo "  - Path: docs/workflow-automation/"
    echo "  - Count: ${doc_count} files (${md_count} markdown)"
    echo "  - Size: ${docs_size}"
    echo ""
    
    echo "Script Files:"
    echo "  - Path: shell_scripts/workflow/"
    echo "  - Count: ${script_count} files (${sh_count} shell, ${yaml_count} yaml)"
    echo "  - Size: ${scripts_size}"
    echo ""
    
    # Analyze directory structure
    if [[ "${VERBOSE_MODE}" == true ]]; then
        echo "Directory Structure:"
        if [[ -d "${SOURCE_SCRIPTS}" ]]; then
            local subdirs=$(find "${SOURCE_SCRIPTS}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
            while IFS= read -r dir; do
                if [[ -n "${dir}" ]]; then
                    local dir_name=$(basename "${dir}")
                    local dir_files=$(find "${dir}" -type f 2>/dev/null | wc -l)
                    echo "  - ${dir_name}/: ${dir_files} files"
                    debug_log "STRUCTURE" "${dir_name}/: ${dir_files} files"
                fi
            done <<< "${subdirs}"
        fi
        echo ""
    fi
    
    # List key files
    echo "Key Files to Migrate:"
    echo ""
    echo "Documentation:"
    if [[ -d "${SOURCE_DOCS}" ]]; then
        local doc_files=()
        while IFS= read -r file; do
            if [[ -n "${file}" ]]; then
                local filename=$(basename "$file")
                local size=$(du -h "$file" 2>/dev/null | cut -f1)
                local lines=$(wc -l < "$file" 2>/dev/null)
                echo "  - ${filename} (${size}, ${lines} lines)"
                debug_log "FILE" "Doc: ${filename} - ${size}, ${lines} lines"
                doc_files+=("${filename}")
            fi
        done < <(find "${SOURCE_DOCS}" -maxdepth 1 -type f -name "*.md" 2>/dev/null)
        debug_array "doc_files"
    fi
    echo ""
    
    echo "Scripts (lib modules):"
    if [[ -d "${SOURCE_SCRIPTS}/lib" ]]; then
        local lib_files=()
        local count=0
        local total_lib_files=$(find "${SOURCE_SCRIPTS}/lib" -maxdepth 1 -type f -name "*.sh" 2>/dev/null | wc -l)
        
        while IFS= read -r file; do
            if [[ -n "${file}" ]] && [[ ${count} -lt 10 ]]; then
                local filename=$(basename "$file")
                local size=$(du -h "$file" 2>/dev/null | cut -f1)
                local lines=$(wc -l < "$file" 2>/dev/null)
                echo "  - lib/${filename} (${size}, ${lines} lines)"
                debug_log "FILE" "Lib: ${filename} - ${size}, ${lines} lines"
                lib_files+=("${filename}")
                ((count++))
            fi
        done < <(find "${SOURCE_SCRIPTS}/lib" -maxdepth 1 -type f -name "*.sh" 2>/dev/null)
        
        local remaining=$((total_lib_files - 10))
        if [[ ${remaining} -gt 0 ]]; then
            echo "  ... and ${remaining} more files"
            debug_log "COUNT" "Additional lib files not listed: ${remaining}"
        fi
        debug_array "lib_files"
    fi
    echo ""
    
    # Calculate total migration size
    local total_bytes=$((docs_size_bytes + scripts_size_bytes))
    local total_files=$((doc_count + script_count))
    debug_log "TOTAL" "Migration size: ${total_bytes} bytes, ${total_files} files"
    
    if [[ "${VERBOSE_MODE}" == true ]]; then
        echo "Total Migration:"
        echo "  - Files: ${total_files}"
        echo "  - Size: $(numfmt --to=iec-i --suffix=B ${total_bytes} 2>/dev/null || echo "${total_bytes} bytes")"
        echo ""
    fi
    
    log_action "Migration analysis: ${doc_count} docs, ${script_count} scripts, ${total_bytes} bytes"
    
    function_exit 0
}

# ==============================================================================
# BACKUP FUNCTIONS
# ==============================================================================

create_backup() {
    function_enter
    
    print_header "CREATING BACKUP"
    
    local backup_dir="${SOURCE_PROJECT}/backups/workflow_migration_$(date +%Y%m%d_%H%M%S)"
    
    debug_log "BACKUP" "Creating backup directory: ${backup_dir}"
    debug_exec "mkdir -p '${backup_dir}'"
    
    print_info "Creating backup at: ${backup_dir}"
    
    # Backup documentation
    if [[ -d "${SOURCE_DOCS}" ]]; then
        local docs_dest="${backup_dir}/docs_workflow-automation"
        debug_log "BACKUP" "Backing up documentation to: ${docs_dest}"
        
        if [[ "${DRY_RUN}" == false ]]; then
            debug_exec "cp -r '${SOURCE_DOCS}' '${docs_dest}'"
            
            # Verify backup
            if [[ -d "${docs_dest}" ]]; then
                local backed_up_count=$(find "${docs_dest}" -type f 2>/dev/null | wc -l)
                debug_log "VERIFY" "Documentation backup: ${backed_up_count} files"
                print_success "Documentation backed up (${backed_up_count} files)"
            else
                print_error_with_context "Documentation backup failed" "${LINENO}"
            fi
        else
            print_info "[DRY RUN] Would backup documentation"
        fi
    else
        debug_log "WARNING" "Source documentation not found, skipping backup"
        print_warning "Source documentation not found, skipping backup"
    fi
    
    # Backup scripts
    if [[ -d "${SOURCE_SCRIPTS}" ]]; then
        local scripts_dest="${backup_dir}/shell_scripts_workflow"
        debug_log "BACKUP" "Backing up scripts to: ${scripts_dest}"
        
        if [[ "${DRY_RUN}" == false ]]; then
            debug_exec "cp -r '${SOURCE_SCRIPTS}' '${scripts_dest}'"
            
            # Verify backup
            if [[ -d "${scripts_dest}" ]]; then
                local backed_up_count=$(find "${scripts_dest}" -type f 2>/dev/null | wc -l)
                debug_log "VERIFY" "Scripts backup: ${backed_up_count} files"
                print_success "Scripts backed up (${backed_up_count} files)"
            else
                print_error_with_context "Scripts backup failed" "${LINENO}"
            fi
        else
            print_info "[DRY RUN] Would backup scripts"
        fi
    else
        debug_log "WARNING" "Source scripts not found, skipping backup"
        print_warning "Source scripts not found, skipping backup"
    fi
    
    # Create backup metadata
    local metadata_file="${backup_dir}/BACKUP_INFO.txt"
    debug_log "METADATA" "Creating backup metadata: ${metadata_file}"
    
    if [[ "${DRY_RUN}" == false ]]; then
        cat > "${metadata_file}" << EOF
Workflow Migration Backup
Created: ${MIGRATION_DATE}
Script Version: ${SCRIPT_VERSION}

Source Project: ${SOURCE_PROJECT}
Target Project: ${TARGET_PROJECT}

Backup Contents:
- docs_workflow-automation/ (documentation files)
- shell_scripts_workflow/ (workflow scripts)

This backup was created before migrating workflow automation
files to the ai_workflow repository.
EOF
        
        if [[ -f "${metadata_file}" ]]; then
            debug_log "VERIFY" "Metadata file created successfully"
        else
            print_error_with_context "Metadata file creation failed" "${LINENO}"
        fi
    fi
    
    print_success "Backup created: ${backup_dir}"
    log_action "Backup created: ${backup_dir}"
    
    debug_log "BACKUP" "Backup complete: ${backup_dir}"
    function_exit 0
    
    echo "${backup_dir}"
}

# ==============================================================================
# MIGRATION FUNCTIONS
# ==============================================================================

prepare_target_directories() {
    function_enter
    
    print_header "PHASE 2: MIGRATION - TARGET PREPARATION"
    
    debug_log "PHASE" "Starting target preparation"
    
    if [[ "${DRY_RUN}" == true ]]; then
        print_info "[DRY RUN] Would prepare target directories"
        print_info "[DRY RUN]   - Create ai_workflow/ directory (if needed)"
        print_info "[DRY RUN]   - Initialize git repository (if needed)"
        print_info "[DRY RUN]   - Create directory structure (if needed)"
        
        debug_log "DRY-RUN" "Skipping actual directory preparation"
        function_exit 0
        return 0
    fi
    
    # 1. Creates ai_workflow/ directory (if needed)
    debug_log "STEP" "1. Check/create ai_workflow/ directory"
    if [[ ! -d "${TARGET_PROJECT}" ]]; then
        print_info "Creating ai_workflow/ directory..."
        debug_exec "mkdir -p '${TARGET_PROJECT}'"
        
        if [[ -d "${TARGET_PROJECT}" ]]; then
            print_success "Created ai_workflow/ directory"
            log_action "Created: ${TARGET_PROJECT}"
            debug_log "VERIFY" "Target project directory created"
        else
            print_error_with_context "Failed to create target project directory" "${LINENO}"
            function_exit 1
            return 1
        fi
    else
        print_info "ai_workflow/ directory already exists"
        debug_log "CHECK" "Target project directory exists"
    fi
    
    # 2. Initializes git repository (if needed)
    debug_log "STEP" "2. Check/initialize git repository"
    if [[ ! -d "${TARGET_PROJECT}/.git" ]]; then
        print_info "Initializing git repository..."
        
        debug_log "GIT" "Running git init in ${TARGET_PROJECT}"
        (
            cd "${TARGET_PROJECT}" || exit 1
            debug_exec "git init"
            
            if [[ -d ".git" ]]; then
                print_success "Initialized git repository"
                log_action "Git init: ${TARGET_PROJECT}"
                debug_log "VERIFY" "Git repository initialized"
                
                # Configure git if needed
                if command -v git &>/dev/null; then
                    local git_user=$(git config user.name 2>/dev/null || echo "")
                    local git_email=$(git config user.email 2>/dev/null || echo "")
                    debug_log "GIT" "Git user: ${git_user:-not configured}"
                    debug_log "GIT" "Git email: ${git_email:-not configured}"
                fi
            else
                print_error_with_context "Git initialization failed" "${LINENO}"
            fi
        )
    else
        print_info "Git repository already initialized"
        debug_log "CHECK" "Git repository exists"
        
        # Get git status
        if command -v git &>/dev/null; then
            local branch=$(cd "${TARGET_PROJECT}" && git branch --show-current 2>/dev/null)
            local status=$(cd "${TARGET_PROJECT}" && git status --short 2>/dev/null | wc -l)
            debug_log "GIT" "Current branch: ${branch:-none}"
            debug_log "GIT" "Uncommitted changes: ${status}"
            
            if [[ ${status} -gt 0 ]] && [[ "${VERBOSE_MODE}" == true ]]; then
                print_warning "Target repository has ${status} uncommitted changes"
            fi
        fi
    fi
    
    # 3. Creates directory structure (if needed)
    debug_log "STEP" "3. Create directory structure"
    local dirs_created=0
    
    # Create docs directory
    if [[ ! -d "${TARGET_DOCS}" ]]; then
        debug_log "CREATE" "Creating docs directory: ${TARGET_DOCS}"
        debug_exec "mkdir -p '${TARGET_DOCS}'"
        
        if [[ -d "${TARGET_DOCS}" ]]; then
            ((dirs_created++))
            print_success "Created docs/workflow-automation/ directory"
            log_action "Created: ${TARGET_DOCS}"
            debug_log "VERIFY" "Docs directory created"
        else
            print_error_with_context "Failed to create docs directory" "${LINENO}"
        fi
    else
        print_info "docs/workflow-automation/ directory already exists"
        debug_log "CHECK" "Docs directory exists"
        
        # Count existing files
        local existing_files=$(find "${TARGET_DOCS}" -type f 2>/dev/null | wc -l)
        debug_log "INFO" "Existing docs files: ${existing_files}"
        
        if [[ ${existing_files} -gt 0 ]] && [[ "${VERBOSE_MODE}" == true ]]; then
            print_warning "Target docs directory already has ${existing_files} files"
        fi
    fi
    
    # Create scripts directory
    if [[ ! -d "${TARGET_SCRIPTS}" ]]; then
        debug_log "CREATE" "Creating scripts directory: ${TARGET_SCRIPTS}"
        debug_exec "mkdir -p '${TARGET_SCRIPTS}'"
        
        if [[ -d "${TARGET_SCRIPTS}" ]]; then
            ((dirs_created++))
            print_success "Created shell_scripts/workflow/ directory"
            log_action "Created: ${TARGET_SCRIPTS}"
            debug_log "VERIFY" "Scripts directory created"
        else
            print_error_with_context "Failed to create scripts directory" "${LINENO}"
        fi
    else
        print_info "shell_scripts/workflow/ directory already exists"
        debug_log "CHECK" "Scripts directory exists"
        
        # Count existing files
        local existing_files=$(find "${TARGET_SCRIPTS}" -type f -name "*.sh" 2>/dev/null | wc -l)
        debug_log "INFO" "Existing script files: ${existing_files}"
        
        if [[ ${existing_files} -gt 0 ]] && [[ "${VERBOSE_MODE}" == true ]]; then
            print_warning "Target scripts directory already has ${existing_files} shell scripts"
        fi
    fi
    
    # Summary
    if [[ ${dirs_created} -gt 0 ]]; then
        print_success "Target directory structure prepared (${dirs_created} directories created)"
        debug_log "SUMMARY" "Created ${dirs_created} directories"
    else
        print_info "Target directory structure already exists"
        debug_log "SUMMARY" "No directories created (all exist)"
    fi
    
    function_exit 0
}

migrate_documentation() {
    function_enter
    
    print_header "MIGRATING DOCUMENTATION"
    
    debug_log "MIGRATE" "Starting documentation migration"
    
    # Check source exists
    if [[ ! -d "${SOURCE_DOCS}" ]]; then
        print_warning "Source documentation not found, skipping"
        debug_log "WARNING" "Source docs directory not found: ${SOURCE_DOCS}"
        function_exit 0
        return 0
    fi
    
    debug_log "CHECK" "Source docs exist: ${SOURCE_DOCS}"
    
    # Count source files
    local source_count=$(find "${SOURCE_DOCS}" -type f 2>/dev/null | wc -l)
    debug_log "COUNT" "Source documentation files: ${source_count}"
    
    if [[ ${source_count} -eq 0 ]]; then
        print_warning "Source documentation directory is empty, skipping"
        debug_log "WARNING" "No files in source docs directory"
        function_exit 0
        return 0
    fi
    
    # Dry run mode
    if [[ "${DRY_RUN}" == true ]]; then
        print_info "[DRY RUN] Would copy ${source_count} documentation files:"
        
        local count=0
        while IFS= read -r file; do
            if [[ -n "${file}" ]]; then
                local rel_path="${file#${SOURCE_DOCS}/}"
                local size=$(du -h "${file}" 2>/dev/null | cut -f1)
                echo "  ${rel_path} (${size})"
                debug_log "DRY-RUN" "Would copy: ${rel_path}"
                
                ((count++))
                if [[ ${count} -ge 20 ]] && [[ "${VERBOSE_MODE}" != true ]]; then
                    local remaining=$((source_count - 20))
                    echo "  ... and ${remaining} more files"
                    break
                fi
            fi
        done < <(find "${SOURCE_DOCS}" -type f 2>/dev/null)
        
        function_exit 0
        return 0
    fi
    
    # Copy documentation files
    print_info "Copying documentation files..."
    debug_log "RSYNC" "Source: ${SOURCE_DOCS}/"
    debug_log "RSYNC" "Target: ${TARGET_DOCS}/"
    
    # Use rsync with verbose output captured for debug
    if [[ "${TRACE_MODE}" == true ]]; then
        debug_exec "rsync -av --progress '${SOURCE_DOCS}/' '${TARGET_DOCS}/'"
    else
        debug_exec "rsync -a '${SOURCE_DOCS}/' '${TARGET_DOCS}/'"
    fi
    
    local rsync_exit=$?
    debug_log "RSYNC" "Exit code: ${rsync_exit}"
    
    if [[ ${rsync_exit} -ne 0 ]]; then
        print_error_with_context "Documentation migration failed (rsync exit: ${rsync_exit})" "${LINENO}"
        function_exit 1
        return 1
    fi
    
    # Verify migration
    if [[ ! -d "${TARGET_DOCS}" ]]; then
        print_error_with_context "Target documentation directory not found after migration" "${LINENO}"
        function_exit 1
        return 1
    fi
    
    # Count migrated files
    local migrated_count=$(find "${TARGET_DOCS}" -type f 2>/dev/null | wc -l)
    debug_log "VERIFY" "Migrated files: ${migrated_count}"
    
    # Compare counts
    if [[ ${migrated_count} -ne ${source_count} ]]; then
        print_warning "File count mismatch: source=${source_count}, migrated=${migrated_count}"
        debug_log "WARNING" "Count mismatch: ${source_count} != ${migrated_count}"
    fi
    
    # Calculate sizes
    local source_size=$(du -sb "${SOURCE_DOCS}" 2>/dev/null | cut -f1)
    local target_size=$(du -sb "${TARGET_DOCS}" 2>/dev/null | cut -f1)
    debug_log "SIZE" "Source: ${source_size} bytes"
    debug_log "SIZE" "Target: ${target_size} bytes"
    
    if [[ "${VERBOSE_MODE}" == true ]]; then
        echo "  Source files: ${source_count}"
        echo "  Migrated files: ${migrated_count}"
        echo "  Source size: $(numfmt --to=iec-i --suffix=B ${source_size} 2>/dev/null || echo "${source_size} bytes")"
        echo "  Target size: $(numfmt --to=iec-i --suffix=B ${target_size} 2>/dev/null || echo "${target_size} bytes")"
    fi
    
    print_success "Migrated ${migrated_count} documentation files"
    log_action "Migrated ${migrated_count} documentation files"
    
    function_exit 0
}

migrate_scripts() {
    function_enter
    
    print_header "MIGRATING WORKFLOW SCRIPTS"
    
    debug_log "MIGRATE" "Starting scripts migration"
    
    # Check source exists
    if [[ ! -d "${SOURCE_SCRIPTS}" ]]; then
        print_warning "Source scripts not found, skipping"
        debug_log "WARNING" "Source scripts directory not found: ${SOURCE_SCRIPTS}"
        function_exit 0
        return 0
    fi
    
    debug_log "CHECK" "Source scripts exist: ${SOURCE_SCRIPTS}"
    
    # Count source files
    local source_count=$(find "${SOURCE_SCRIPTS}" -type f 2>/dev/null | wc -l)
    local source_sh_count=$(find "${SOURCE_SCRIPTS}" -type f -name "*.sh" 2>/dev/null | wc -l)
    debug_log "COUNT" "Source files: ${source_count} total, ${source_sh_count} shell scripts"
    
    if [[ ${source_count} -eq 0 ]]; then
        print_warning "Source scripts directory is empty, skipping"
        debug_log "WARNING" "No files in source scripts directory"
        function_exit 0
        return 0
    fi
    
    # Dry run mode
    if [[ "${DRY_RUN}" == true ]]; then
        print_info "[DRY RUN] Would copy ${source_count} script files (${source_sh_count} shell scripts):"
        
        local count=0
        while IFS= read -r file; do
            if [[ -n "${file}" ]]; then
                local rel_path="${file#${SOURCE_SCRIPTS}/}"
                local size=$(du -h "${file}" 2>/dev/null | cut -f1)
                local lines=$(wc -l < "${file}" 2>/dev/null)
                echo "  ${rel_path} (${size}, ${lines} lines)"
                debug_log "DRY-RUN" "Would copy: ${rel_path}"
                
                ((count++))
                if [[ ${count} -ge 20 ]] && [[ "${VERBOSE_MODE}" != true ]]; then
                    local remaining=$((source_sh_count - 20))
                    echo "  ... and ${remaining} more shell scripts"
                    break
                fi
            fi
        done < <(find "${SOURCE_SCRIPTS}" -type f -name "*.sh" 2>/dev/null)
        
        function_exit 0
        return 0
    fi
    
    # Copy script files
    print_info "Copying workflow scripts..."
    debug_log "RSYNC" "Source: ${SOURCE_SCRIPTS}/"
    debug_log "RSYNC" "Target: ${TARGET_SCRIPTS}/"
    
    # Use rsync with verbose output captured for debug
    if [[ "${TRACE_MODE}" == true ]]; then
        debug_exec "rsync -av --progress '${SOURCE_SCRIPTS}/' '${TARGET_SCRIPTS}/'"
    else
        debug_exec "rsync -a '${SOURCE_SCRIPTS}/' '${TARGET_SCRIPTS}/'"
    fi
    
    local rsync_exit=$?
    debug_log "RSYNC" "Exit code: ${rsync_exit}"
    
    if [[ ${rsync_exit} -ne 0 ]]; then
        print_error_with_context "Scripts migration failed (rsync exit: ${rsync_exit})" "${LINENO}"
        function_exit 1
        return 1
    fi
    
    # Verify migration
    if [[ ! -d "${TARGET_SCRIPTS}" ]]; then
        print_error_with_context "Target scripts directory not found after migration" "${LINENO}"
        function_exit 1
        return 1
    fi
    
    # Ensure scripts are executable
    print_info "Setting executable permissions on shell scripts..."
    debug_log "CHMOD" "Making .sh files executable in ${TARGET_SCRIPTS}"
    
    local chmod_count=0
    while IFS= read -r script; do
        if [[ -n "${script}" ]]; then
            debug_exec "chmod +x '${script}'"
            ((chmod_count++))
        fi
    done < <(find "${TARGET_SCRIPTS}" -type f -name "*.sh" 2>/dev/null)
    
    debug_log "CHMOD" "Made ${chmod_count} scripts executable"
    
    if [[ "${VERBOSE_MODE}" == true ]]; then
        echo "  Made ${chmod_count} scripts executable"
    fi
    
    # Count migrated files
    local migrated_count=$(find "${TARGET_SCRIPTS}" -type f 2>/dev/null | wc -l)
    local migrated_sh_count=$(find "${TARGET_SCRIPTS}" -type f -name "*.sh" 2>/dev/null | wc -l)
    debug_log "VERIFY" "Migrated files: ${migrated_count} total, ${migrated_sh_count} shell scripts"
    
    # Compare counts
    if [[ ${migrated_count} -ne ${source_count} ]]; then
        print_warning "File count mismatch: source=${source_count}, migrated=${migrated_count}"
        debug_log "WARNING" "Count mismatch: ${source_count} != ${migrated_count}"
    fi
    
    # Calculate sizes
    local source_size=$(du -sb "${SOURCE_SCRIPTS}" 2>/dev/null | cut -f1)
    local target_size=$(du -sb "${TARGET_SCRIPTS}" 2>/dev/null | cut -f1)
    debug_log "SIZE" "Source: ${source_size} bytes"
    debug_log "SIZE" "Target: ${target_size} bytes"
    
    # Analyze subdirectories
    if [[ "${VERBOSE_MODE}" == true ]]; then
        echo ""
        echo "Migration breakdown:"
        echo "  Total files: ${migrated_count}"
        echo "  Shell scripts: ${migrated_sh_count}"
        echo "  Source size: $(numfmt --to=iec-i --suffix=B ${source_size} 2>/dev/null || echo "${source_size} bytes")"
        echo "  Target size: $(numfmt --to=iec-i --suffix=B ${target_size} 2>/dev/null || echo "${target_size} bytes")"
        
        # Count by subdirectory
        if [[ -d "${TARGET_SCRIPTS}/lib" ]]; then
            local lib_count=$(find "${TARGET_SCRIPTS}/lib" -type f -name "*.sh" 2>/dev/null | wc -l)
            echo "  Library modules: ${lib_count}"
            debug_log "INFO" "Library modules: ${lib_count}"
        fi
        
        if [[ -d "${TARGET_SCRIPTS}/steps" ]]; then
            local steps_count=$(find "${TARGET_SCRIPTS}/steps" -type f -name "*.sh" 2>/dev/null | wc -l)
            echo "  Step modules: ${steps_count}"
            debug_log "INFO" "Step modules: ${steps_count}"
        fi
    fi
    
    print_success "Migrated ${migrated_count} script files (${migrated_sh_count} shell scripts)"
    log_action "Migrated ${migrated_count} script files"
    
    function_exit 0
}

