create_gitignore() {
    function_enter
    
    print_info "Creating .gitignore..."
    
    local gitignore_file="${TARGET_PROJECT}/.gitignore"
    debug_log "CREATE" "Gitignore file: ${gitignore_file}"
    
    cat > "${gitignore_file}" << 'EOF'
# Workflow execution artifacts
shell_scripts/workflow/backlog/
shell_scripts/workflow/summaries/
shell_scripts/workflow/logs/
shell_scripts/workflow/metrics/
shell_scripts/workflow/.checkpoints/

# Temporary files
*.tmp
*.bak
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.sublime-*

# Test coverage
coverage/
*.coverage

# Node modules (if tests use Node.js)
node_modules/

# Environment files
.env
.env.local
EOF
    
    if [[ -f "${gitignore_file}" ]]; then
        local lines=$(wc -l < "${gitignore_file}" 2>/dev/null)
        print_success "Created .gitignore (${lines} lines)"
        debug_log "VERIFY" "Gitignore created: ${lines} lines"
    else
        print_error_with_context "Failed to create .gitignore" "${LINENO}"
    fi
    
    log_action "Created .gitignore"
    function_exit 0
}

create_github_folder() {
    function_enter
    
    print_info "Creating .github folder..."
    
    local github_dir="${TARGET_PROJECT}/.github"
    debug_log "CREATE" "GitHub directory: ${github_dir}"
    
    debug_exec "mkdir -p '${github_dir}'"
    
    # Create a basic README for the .github folder
    cat > "${github_dir}/README.md" << 'EOF'
# .github Directory

This directory contains GitHub-specific configuration files.

## Planned Contents
- GitHub Actions workflows (CI/CD)
- Issue templates
- Pull request templates
- GitHub Copilot instructions
- Dependabot configuration

## Status
Initial setup - configuration files to be added as needed.
EOF
    
    if [[ -d "${github_dir}" ]]; then
        local readme_file="${github_dir}/README.md"
        if [[ -f "${readme_file}" ]]; then
            local lines=$(wc -l < "${readme_file}" 2>/dev/null)
            print_success "Created .github folder with README (${lines} lines)"
            debug_log "VERIFY" ".github directory and README created"
        else
            print_success "Created .github folder"
            debug_log "VERIFY" ".github directory created"
        fi
    else
        print_error_with_context "Failed to create .github folder" "${LINENO}"
    fi
    
    log_action "Created .github folder"
    function_exit 0
}

create_initial_commit() {
    function_enter
    
    print_info "Creating initial commit..."
    
    debug_log "GIT" "Creating initial commit in ${TARGET_PROJECT}"
    
    (
        cd "${TARGET_PROJECT}" || exit 1
        debug_log "GIT" "Changed directory to target project"
        
        # Stage all files
        debug_log "GIT" "Staging all files"
        git add . 2>&1 | while read -r line; do
            debug_log "GIT" "git add: ${line}"
        done
        
        # Check what will be committed
        local staged_count=$(git diff --cached --name-only 2>/dev/null | wc -l)
        debug_log "GIT" "Staged files: ${staged_count}"
        
        if [[ "${VERBOSE_MODE}" == true ]]; then
            echo "  Files staged for commit: ${staged_count}"
        fi
        
        # Create initial commit
        debug_log "GIT" "Creating commit"
        git commit -m "feat: initial workflow automation repository

Migrate workflow automation from mpbarbosa_site repository

Components migrated:
- Complete documentation (docs/workflow-automation/)
- Workflow automation scripts (shell_scripts/workflow/)
- 29 modules (16 libraries + 13 steps)
- 8,264 lines of production code
- 37 tests with 100% pass rate

Version: v2.1.0
Migration Date: ${MIGRATION_DATE}
Source: mpbarbosa_site repository

Features:
- Workflow orchestration with 13-step pipeline
- Metrics collection for performance tracking
- Change detection for smart execution
- Dependency graph for parallelization
- AI integration with GitHub Copilot CLI
- YAML configuration system

See: MIGRATION_README.md for complete details" 2>&1 | while read -r line; do
            debug_log "GIT" "git commit: ${line}"
        done
        
        local commit_exit=$?
        debug_log "GIT" "Commit exit code: ${commit_exit}"
        
        if [[ ${commit_exit} -eq 0 ]]; then
            # Get commit hash
            local commit_hash=$(git rev-parse --short HEAD 2>/dev/null)
            debug_log "GIT" "Commit created: ${commit_hash}"
            
            print_success "Created initial commit (${commit_hash})"
            
            if [[ "${VERBOSE_MODE}" == true ]]; then
                local commit_files=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | wc -l)
                echo "  Files in commit: ${commit_files}"
                debug_log "GIT" "Files in commit: ${commit_files}"
            fi
        else
            print_error_with_context "Failed to create initial commit" "${LINENO}"
            debug_log "ERROR" "Git commit failed with exit code ${commit_exit}"
        fi
        
        log_action "Created initial commit"
    )
    
    function_exit 0
}

# ==============================================================================
# VERIFICATION
# ==============================================================================

verify_migration() {
    function_enter
    
    print_header "VERIFYING MIGRATION"
    
    debug_log "VERIFY" "Starting migration verification"
    
    local errors=0
    local warnings=0
    
    # Verify documentation
    debug_log "CHECK" "Verifying documentation migration"
    if [[ -d "${TARGET_DOCS}" ]]; then
        local doc_count=$(find "${TARGET_DOCS}" -type f 2>/dev/null | wc -l)
        local doc_size=$(du -sh "${TARGET_DOCS}" 2>/dev/null | cut -f1)
        
        debug_log "VERIFY" "Documentation directory exists: ${TARGET_DOCS}"
        debug_log "COUNT" "Documentation files: ${doc_count}"
        
        if [[ ${doc_count} -gt 0 ]]; then
            print_success "Documentation migrated: ${doc_count} files (${doc_size})"
            debug_log "SUCCESS" "Documentation verification passed"
        else
            print_error "No documentation files found"
            debug_log "ERROR" "Documentation directory empty"
            ((errors++))
        fi
    else
        print_error "Documentation directory not found"
        debug_log "ERROR" "Documentation directory missing: ${TARGET_DOCS}"
        ((errors++))
    fi
    
    # Verify scripts
    debug_log "CHECK" "Verifying scripts migration"
    if [[ -d "${TARGET_SCRIPTS}" ]]; then
        local script_count=$(find "${TARGET_SCRIPTS}" -type f -name "*.sh" 2>/dev/null | wc -l)
        local scripts_size=$(du -sh "${TARGET_SCRIPTS}" 2>/dev/null | cut -f1)
        local total_files=$(find "${TARGET_SCRIPTS}" -type f 2>/dev/null | wc -l)
        
        debug_log "VERIFY" "Scripts directory exists: ${TARGET_SCRIPTS}"
        debug_log "COUNT" "Shell scripts: ${script_count}"
        debug_log "COUNT" "Total files: ${total_files}"
        
        if [[ ${script_count} -gt 0 ]]; then
            print_success "Scripts migrated: ${script_count} shell scripts, ${total_files} total files (${scripts_size})"
            debug_log "SUCCESS" "Scripts verification passed"
            
            # Check script permissions
            local executable_count=$(find "${TARGET_SCRIPTS}" -type f -name "*.sh" -executable 2>/dev/null | wc -l)
            debug_log "VERIFY" "Executable scripts: ${executable_count}/${script_count}"
            
            if [[ ${executable_count} -ne ${script_count} ]]; then
                print_warning "${executable_count}/${script_count} scripts are executable"
                debug_log "WARNING" "Not all scripts are executable"
                ((warnings++))
            fi
        else
            print_error "No script files found"
            debug_log "ERROR" "Scripts directory empty"
            ((errors++))
        fi
    else
        print_error "Scripts directory not found"
        debug_log "ERROR" "Scripts directory missing: ${TARGET_SCRIPTS}"
        ((errors++))
    fi
    
    # Verify key files
    debug_log "CHECK" "Verifying key files"
    local key_files=(
        "${TARGET_PROJECT}/MIGRATION_README.md"
        "${TARGET_PROJECT}/.gitignore"
        "${TARGET_PROJECT}/.github/README.md"
        "${TARGET_SCRIPTS}/execute_tests_docs_workflow.sh"
        "${TARGET_SCRIPTS}/lib/metrics.sh"
        "${TARGET_SCRIPTS}/lib/change_detection.sh"
        "${TARGET_SCRIPTS}/lib/dependency_graph.sh"
        "${TARGET_DOCS}/COMPREHENSIVE_WORKFLOW_EXECUTION_ANALYSIS.md"
        "${TARGET_DOCS}/SHORT_TERM_ENHANCEMENTS_COMPLETION.md"
    )
    
    debug_log "CHECK" "Checking ${#key_files[@]} key files"
    
    local found_count=0
    local missing_count=0
    
    for file in "${key_files[@]}"; do
        local rel_path="${file#${TARGET_PROJECT}/}"
        
        if [[ -f "${file}" ]]; then
            local size=$(du -h "${file}" 2>/dev/null | cut -f1)
            print_success "Verified: ${rel_path} (${size})"
            debug_log "VERIFY" "Key file exists: ${rel_path}"
            ((found_count++))
            
            # Additional checks for scripts
            if [[ "${file}" == *.sh ]]; then
                if [[ -x "${file}" ]]; then
                    debug_log "VERIFY" "Script is executable: ${rel_path}"
                else
                    debug_log "WARNING" "Script not executable: ${rel_path}"
                fi
            fi
        else
            print_warning "Missing: ${rel_path}"
            debug_log "WARNING" "Key file missing: ${rel_path}"
            ((missing_count++))
            ((warnings++))
        fi
    done
    
    debug_log "SUMMARY" "Key files: ${found_count} found, ${missing_count} missing"
    
    if [[ "${VERBOSE_MODE}" == true ]]; then
        echo ""
        echo "Verification Summary:"
        echo "  Key files found: ${found_count}/${#key_files[@]}"
        echo "  Warnings: ${warnings}"
        echo "  Errors: ${errors}"
    fi
    
    # Final verdict
    if [[ ${errors} -eq 0 ]]; then
        if [[ ${warnings} -gt 0 ]]; then
            print_success "Migration verification complete ✅ (with ${warnings} warnings)"
        else
            print_success "Migration verification complete ✅"
        fi
        log_action "Migration verified successfully (${warnings} warnings)"
        debug_log "SUCCESS" "Verification passed: 0 errors, ${warnings} warnings"
        
        function_exit 0
        return 0
    else
        print_error "Migration verification failed with ${errors} errors and ${warnings} warnings"
        log_action "Migration verification failed: ${errors} errors, ${warnings} warnings"
        debug_log "FAILURE" "Verification failed: ${errors} errors, ${warnings} warnings"
        
        function_exit 1
        return 1
    fi
}

# ==============================================================================
# REPORTING
# ==============================================================================

generate_summary() {
    function_enter
    
    print_header "MIGRATION SUMMARY"
    
    debug_log "SUMMARY" "Generating migration summary"
    
    local doc_count=0
    local script_count=0
    local doc_size="0"
    local script_size="0"
    
    if [[ -d "${TARGET_DOCS}" ]]; then
        doc_count=$(find "${TARGET_DOCS}" -type f 2>/dev/null | wc -l)
        doc_size=$(du -sh "${TARGET_DOCS}" 2>/dev/null | cut -f1)
        debug_log "SUMMARY" "Documentation: ${doc_count} files, ${doc_size}"
    fi
    
    if [[ -d "${TARGET_SCRIPTS}" ]]; then
        script_count=$(find "${TARGET_SCRIPTS}" -type f 2>/dev/null | wc -l)
        script_size=$(du -sh "${TARGET_SCRIPTS}" 2>/dev/null | cut -f1)
        debug_log "SUMMARY" "Scripts: ${script_count} files, ${script_size}"
    fi
    
    # Count shell scripts specifically
    local sh_count=0
    if [[ -d "${TARGET_SCRIPTS}" ]]; then
        sh_count=$(find "${TARGET_SCRIPTS}" -type f -name "*.sh" 2>/dev/null | wc -l)
        debug_log "SUMMARY" "Shell scripts: ${sh_count}"
    fi
    
    cat << EOF
Migration completed successfully! ✅

Source:  ${SOURCE_PROJECT}
Target:  ${TARGET_PROJECT}

Files Migrated:
  - Documentation: ${doc_count} files (${doc_size})
  - Scripts:       ${script_count} files (${script_size})
    └─ Shell scripts: ${sh_count}

Repository Setup:
  - MIGRATION_README.md
  - .gitignore
  - .github folder
  - Initial git commit

Next Steps:
  1. Review migrated files: cd ${TARGET_PROJECT}
  2. Run tests: cd shell_scripts/workflow/lib && ./test_enhancements.sh
  3. Update references in mpbarbosa_site repository
  4. Push to remote: git remote add origin <url> && git push -u origin main

Logs:
  - Migration Log: ${MIGRATION_LOG}
EOF
    
    if [[ "${DEBUG_MODE}" == true ]]; then
        echo "  - Debug Log:     ${DEBUG_LOG}"
    fi
    
    echo ""
    
    # Verbose summary
    if [[ "${VERBOSE_MODE}" == true ]]; then
        echo "Additional Details:"
        
        # Subdirectory breakdown
        if [[ -d "${TARGET_SCRIPTS}/lib" ]]; then
            local lib_count=$(find "${TARGET_SCRIPTS}/lib" -type f -name "*.sh" 2>/dev/null | wc -l)
            echo "  - Library modules: ${lib_count}"
            debug_log "DETAIL" "Library modules: ${lib_count}"
        fi
        
        if [[ -d "${TARGET_SCRIPTS}/steps" ]]; then
            local steps_count=$(find "${TARGET_SCRIPTS}/steps" -type f -name "*.sh" 2>/dev/null | wc -l)
            echo "  - Step modules: ${steps_count}"
            debug_log "DETAIL" "Step modules: ${steps_count}"
        fi
        
        # Git status
        if [[ -d "${TARGET_PROJECT}/.git" ]]; then
            local branch=$(cd "${TARGET_PROJECT}" && git branch --show-current 2>/dev/null)
            local commits=$(cd "${TARGET_PROJECT}" && git rev-list --count HEAD 2>/dev/null)
            echo "  - Git branch: ${branch:-main}"
            echo "  - Git commits: ${commits:-0}"
            debug_log "GIT" "Branch: ${branch}, Commits: ${commits}"
        fi
        
        echo ""
    fi
    
    log_action "Migration summary generated"
    debug_log "SUMMARY" "Summary generation complete"
    
    function_exit 0
}

# ==============================================================================
# MAIN EXECUTION
# ==============================================================================

show_usage() {
    cat << EOF
Usage: $(basename "$0") [OPTIONS]

Migrate workflow automation files to ai_workflow repository.

Options:
  --dry-run         Preview migration without making changes
  --debug           Enable debug logging to file
  --verbose         Show detailed progress and verbose output
  --trace           Enable trace mode (debug + live output)
  --help            Show this help message
  --version         Show script version

Debug Options:
  --debug           Logs detailed debugging information to:
                    ${SOURCE_PROJECT}/shell_scripts/workflow_migration_debug_*.log
  --verbose         Shows progress indicators, call stacks, and detailed summaries
  --trace           Combines --debug and --verbose with real-time output

Examples:
  # Preview migration
  $(basename "$0") --dry-run
  
  # Execute migration with verbose output
  $(basename "$0") --verbose
  
  # Execute with full debug tracing
  $(basename "$0") --trace
  
  # Dry-run with debug logging
  $(basename "$0") --dry-run --debug

Source: ${SOURCE_PROJECT}
Target: ${TARGET_PROJECT}

Debug Logs: workflow_migration_debug_*.log
Migration Logs: workflow_migration_log_*.txt
EOF
}

main() {
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            --debug)
                DEBUG_MODE=true
                shift
                ;;
            --verbose)
                VERBOSE_MODE=true
                shift
                ;;
            --trace)
                TRACE_MODE=true
                DEBUG_MODE=true
                VERBOSE_MODE=true
                shift
                ;;
            --help)
                show_usage
                exit 0
                ;;
            --version)
                echo "Workflow Migration Script v${SCRIPT_VERSION}"
                exit 0
                ;;
            *)
                echo "Unknown option: $1"
                show_usage
                exit 1
                ;;
        esac
    done
    
    # Initialize debug log
    if [[ "${DEBUG_MODE}" == true ]]; then
        echo "# Workflow Migration Debug Log" > "${DEBUG_LOG}"
        echo "# Started: $(date '+%Y-%m-%d %H:%M:%S')" >> "${DEBUG_LOG}"
        echo "# Script Version: ${SCRIPT_VERSION}" >> "${DEBUG_LOG}"
        echo "# Debug Mode: ${DEBUG_MODE}" >> "${DEBUG_LOG}"
        echo "# Verbose Mode: ${VERBOSE_MODE}" >> "${DEBUG_LOG}"
        echo "# Trace Mode: ${TRACE_MODE}" >> "${DEBUG_LOG}"
        echo "# Dry Run: ${DRY_RUN}" >> "${DEBUG_LOG}"
        echo "# " >> "${DEBUG_LOG}"
        
        debug_log "INIT" "Debug logging initialized"
        debug_log "CONFIG" "Script version: ${SCRIPT_VERSION}"
        debug_var "SOURCE_PROJECT"
        debug_var "TARGET_PROJECT"
        debug_var "DRY_RUN"
        debug_var "DEBUG_MODE"
        debug_var "VERBOSE_MODE"
        debug_var "TRACE_MODE"
    fi
    
    # Print header
    echo ""
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║          Workflow Automation Migration Script v${SCRIPT_VERSION}           ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    # Show active modes
    local modes=()
    [[ "${DRY_RUN}" == true ]] && modes+=("DRY-RUN")
    [[ "${DEBUG_MODE}" == true ]] && modes+=("DEBUG")
    [[ "${VERBOSE_MODE}" == true ]] && modes+=("VERBOSE")
    [[ "${TRACE_MODE}" == true ]] && modes+=("TRACE")
    
    if [[ ${#modes[@]} -gt 0 ]]; then
        local mode_str=$(IFS=', '; echo "${modes[*]}")
        print_warning "Active modes: ${mode_str}"
        echo ""
        
        if [[ "${DEBUG_MODE}" == true ]]; then
            echo -e "${GRAY}Debug log: ${DEBUG_LOG}${NC}"
            echo ""
        fi
    fi
    
    # Initialize log
    log_action "Migration started (v${SCRIPT_VERSION})"
    log_action "Modes: DRY_RUN=${DRY_RUN}, DEBUG=${DEBUG_MODE}, VERBOSE=${VERBOSE_MODE}, TRACE=${TRACE_MODE}"
    
    debug_log "MAIN" "Starting migration workflow"
    
    # Execute migration steps
    local exit_code=0
    
    validate_source_project || { exit_code=$?; print_error_with_context "Source validation failed" "${LINENO}"; exit ${exit_code}; }
    validate_target_project || { exit_code=$?; print_error_with_context "Target validation failed" "${LINENO}"; exit ${exit_code}; }
    
    analyze_migration
    
    # Create backup (skip in dry run)
    if [[ "${DRY_RUN}" == false ]]; then
        create_backup
    else
        debug_log "SKIP" "Skipping backup in dry-run mode"
    fi
    
    prepare_target_directories
    migrate_documentation
    migrate_scripts
    
    # Repository setup (skip in dry run)
    if [[ "${DRY_RUN}" == false ]]; then
        setup_repository
    else
        setup_repository  # Will show dry-run output
    fi
    
    verify_migration
    generate_summary
    
    # Print performance summary
    print_performance_summary
    
    log_action "Migration completed successfully"
    debug_log "MAIN" "Migration workflow completed"
    
    # Final debug summary
    if [[ "${DEBUG_MODE}" == true ]]; then
        echo ""
        echo -e "${GRAY}════════════════════════════════════════════════${NC}"
        echo -e "${GRAY}Debug Information:${NC}"
        echo -e "${GRAY}  Debug log: ${DEBUG_LOG}${NC}"
        echo -e "${GRAY}  Migration log: ${MIGRATION_LOG}${NC}"
        echo -e "${GRAY}  Total function calls: ${#FUNCTION_CALL_COUNTS[@]}${NC}"
        echo -e "${GRAY}════════════════════════════════════════════════${NC}"
    fi
    
    echo ""
    print_success "Migration complete! 🎉"
    echo ""
}

# Run main function
main "$@"
